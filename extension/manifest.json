{
  "manifest_version": 3,
  "name": "Local Voice Transcriber",
  "version": "0.1.0",
  "description": "Transcribes voice notes in WhatsApp Web on your own computer with a local Whisper model. Not affiliated with WhatsApp or Meta.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "key": "",
  "action": {
    "default_title": "Local Voice Transcriber",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["selectors.js", "ui.js", "capture.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
