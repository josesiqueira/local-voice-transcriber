---
// Illustration of the extension's interface: a voice note with the T button, and a voice note
// whose transcript caption is shown. Drawn from extension/ui.js and extension/content.css;
// made-up content, no real chat. Colors come from theme tokens, so it follows light and dark mode.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;

// Fixed bar heights so the waveform looks like speech and renders the same every build.
const heights = [6, 10, 16, 22, 14, 8, 12, 20, 26, 18, 10, 6, 9, 15, 21, 17, 11, 7, 12, 19, 24, 16, 9, 6, 11, 17, 13, 8, 6, 10, 14, 9, 6, 8];
const bars = heights.map((h, i) => ({ x: 74 + i * 5.4, h }));
---

<svg
	class:list={['voice-note', className]}
	viewBox="0 0 400 300"
	role="img"
	aria-labelledby="vn-title vn-desc"
	xmlns="http://www.w3.org/2000/svg"
>
	<title id="vn-title">A transcribed voice note</title>
	<desc id="vn-desc">
		Two voice notes in a chat. Under the first one is a small button labelled T. Under the second
		one is its transcript: "Running about ten minutes late. Can you save me a seat near the
		window?", followed by the language tag EN and a Copy link.
	</desc>

	<rect class="panel" x="0.5" y="0.5" width="399" height="299" rx="16"></rect>

	<g>
		<rect class="bubble" x="20" y="20" width="290" height="60" rx="10"></rect>
		<circle class="play-bg" cx="48" cy="48" r="15"></circle>
		<path class="play" d="M43.5 40.5 L55 48 L43.5 55.5 Z"></path>
		{bars.map((b) => <rect class="bar" x={b.x} y={46 - b.h / 2} width="2.6" height={b.h} rx="1.3" />)}
		<text class="meta-text" x="74" y="72">0:42</text>
		<text class="meta-text" x="298" y="72" text-anchor="end">10:24</text>
	</g>
	<rect class="t-ring" x="16" y="86" width="36" height="26" rx="13"></rect>
	<rect class="t-btn" x="20" y="90" width="28" height="18" rx="9"></rect>
	<text class="t-label" x="34" y="103" text-anchor="middle">T</text>

	<g>
		<rect class="bubble" x="20" y="126" width="290" height="60" rx="10"></rect>
		<circle class="play-bg" cx="48" cy="154" r="15"></circle>
		<path class="play" d="M43.5 146.5 L55 154 L43.5 161.5 Z"></path>
		{bars.map((b, i) => <rect class="bar" x={b.x} y={152 - heights[(i + 11) % heights.length] / 2} width="2.6" height={heights[(i + 11) % heights.length]} rx="1.3" />)}
		<text class="meta-text" x="74" y="178">0:09</text>
		<text class="meta-text" x="298" y="178" text-anchor="end">10:31</text>
	</g>
	<rect class="caption" x="20" y="194" width="340" height="86" rx="8"></rect>
	<text class="caption-text" x="32" y="218">Running about ten minutes late. Can you</text>
	<text class="caption-text" x="32" y="238">save me a seat near the window?</text>
	<text class="lang" x="32" y="264">EN</text>
	<text class="copy" x="56" y="264">Copy</text>
	<line class="copy-line" x1="56" y1="266.5" x2="80" y2="266.5"></line>
</svg>

<style>
	.voice-note {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--__sl-font);
	}
	.panel {
		fill: var(--lt-surface);
		stroke: var(--sl-color-gray-5);
	}
	/* Light mode: a warmer card, so the white bubbles stand out from the white page. */
	:global(:root[data-theme='light']) .panel {
		fill: var(--lt-surface-2);
	}
	.bubble {
		fill: var(--lt-bubble-in);
		stroke: var(--sl-color-gray-5);
	}
	.play-bg {
		fill: var(--sl-color-gray-6);
		stroke: var(--lt-line);
	}
	.play {
		fill: var(--sl-color-gray-2);
	}
	.bar {
		fill: var(--sl-color-gray-3);
	}
	.meta-text {
		font-size: 10px;
		fill: var(--sl-color-gray-3);
	}
	.t-ring {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 1.5;
		opacity: 0.55;
	}
	.t-btn {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
	}
	.t-label {
		font-size: 11px;
		font-weight: 600;
		fill: var(--sl-color-white);
	}
	.caption {
		fill: var(--sl-color-gray-6);
		stroke: var(--lt-line);
	}
	.caption-text {
		font-size: 13px;
		fill: var(--sl-color-white);
	}
	.lang {
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.04em;
		fill: var(--sl-color-gray-2);
	}
	.copy {
		font-size: 10.5px;
		fill: var(--sl-color-gray-2);
	}
	.copy-line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
</style>
